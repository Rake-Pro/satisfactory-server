// Exit immediately (nonzero) when a command fails so the retry loop in
// functions.sh sees the failure instead of steamcmd swallowing it.
@ShutdownOnFailedCommand 1

// No password as this is unattended
@NoPromptForPassword 1

// Set the game installation directory
force_install_dir /satisfactory

login anonymous

// Install/Update the Satisfactory Dedicated Server (app 1690800)
app_update 1690800 validate

quit
